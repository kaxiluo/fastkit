APP_NAME=fastkit
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/fastkit
REDIS_URL=redis://localhost:6379/0
BROKER_URL=amqp://guest:guest@localhost:5672/fastkit

# 消息引擎参数在 app/infrastructure/messaging/settings.py 都有默认值;按需用 MESSAGING_* 环境变量覆盖
# worker 副本数(须与 uvicorn --workers 起进程数一致);缺省 1
WORKER_REPLICAS=1
