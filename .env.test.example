# 测试专用连接串。复制到 .env.test 后按需修改。
# 与 .env 不冲突:测试用独立 DB / 独立 Redis db 号 / 独立 RabbitMQ vhost。

APP_NAME=fastkit-test
APP_ENV=test
LOG_LEVEL=WARNING
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/fastkit_test
REDIS_URL=redis://localhost:6379/15
BROKER_URL=amqp://guest:guest@localhost:5672/fastkit_test

# 多数据库集成测试(可选):第二 PG 数据库(复用同一 PG 服务器,不同 db name)
# 在跑集成测试前先创建:psql -U postgres -c "CREATE DATABASE fastkit_test_secondary;"
DATABASE_SECONDARY_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/fastkit_test_secondary

# 集成测试 session 开跑前会清空 test vhost 全部队列(清除跨会话/中断残留的化石消息),
# 走 RabbitMQ management API(host 取自 BROKER_URL,端口用默认 15672)。

# 重试与延迟队列(测试用 500ms TTL 加速集成测试;默认 30000ms 会让重试用例卡死)
MESSAGING_RETRY_TTL_MS=500
