# 测试专用连接串。复制到 .env.test 后按需修改。
# 与 .env 不冲突:测试用独立 DB / 独立 Redis db 号 / 独立 RabbitMQ vhost。

APP_NAME=fastkit-test
APP_ENV=test
LOG_LEVEL=WARNING
LOG_FORMAT=json

DATABASE_URL=postgresql+asyncpg://myuser:changeme@localhost:5432/fastkit_test
REDIS_URL=redis://localhost:6379/15
BROKER_URL=amqp://myuser:changeme@localhost:5672/fastkit_test

# 引擎 MQ 资源名默认由 APP_NAME 派生 (如 {app_name}.dlx / .dlq / .retry.ex / .retry.30s); 特殊场景可用 MESSAGING_DLQ_EXCHANGE 等显式覆盖

# 重试与延迟队列(测试用 500ms TTL 加速集成测试;默认 30000ms 会让重试用例卡死)
MESSAGING_RETRY_TTL_MS=500
